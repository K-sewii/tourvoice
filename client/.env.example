# Base URL of TourVoice.API (no trailing slash). Used for REST and the SignalR presence hub.
VITE_API_URL=http://localhost:5049

# Optional raster tile template for Leaflet. Default uses the CARTO basemap CDN
# (no API key). Switch to OSM or another provider if you have a self-hosted setup, e.g.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
