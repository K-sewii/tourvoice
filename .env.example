# Sao chep thanh .env (khong commit .env). Dung cho docker-compose.yml.

# MySQL 8.4
DB_PASSWORD=change-me-password
DB_ROOT_PASSWORD=change-me-root

# JWT HS256 (ADR-06): khoa ngau nhien it nhat 32 ky tu.
JWT_KEY=change-me-to-a-random-secret-at-least-32-characters
JWT_ISSUER=TourVoice
JWT_AUDIENCE=TourVoiceClient

# MyMemory: email cua nhom o tham so de -> 50.000 ky tu/ngay (an danh chi 5.000).
MYMEMORY_EMAIL=team@example.com

# Web
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:5049
