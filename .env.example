# Sao chep thanh .env (khong commit .env). Dung cho docker-compose.yml.
# Tren Codespaces: chay `bash .devcontainer/setup.sh` de tu dien secret + WEB_ORIGIN.

# MySQL 8.4
DB_PASSWORD=change-me-password
DB_ROOT_PASSWORD=change-me-root

# JWT HS256 (ADR-06): khoa ngau nhien it nhat 32 ky tu.
JWT_KEY=change-me-to-a-random-secret-at-least-32-characters
JWT_ISSUER=TourVoice
JWT_AUDIENCE=TourVoiceClient

# MyMemory: email cua nhom o tham so de -> 50.000 ky tu/ngay (an danh chi 5.000).
MYMEMORY_EMAIL=team@example.com

# Web
# Origin trinh duyet mo web. Tren Codespaces la https://<codespace>-5173.<domain>
# (.devcontainer/setup.sh tu dien; local de http://localhost:5173).
WEB_ORIGIN=http://localhost:5173

# Base URL cua API nhung vao bundle luc build.
# De TRONG = goi qua nginx cung origin (mac dinh, chay duoc tren moi host).
# Chi dat khi web va API o hai domain khac nhau, vd https://api.example.com
VITE_API_URL=

# Template tile ban do Leaflet. De trong = CARTO (khong can API key).
# Vd dung OSM: VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_URL=
