# Copy thanh .env tren MAY CHU (khong commit .env).
# cd.yml tu truyen API_IMAGE / WEB_IMAGE / IMAGE_TAG khi deploy; neu chay tay thi dien o day.

API_IMAGE=ghcr.io/K-sewii/tourvoice-api
WEB_IMAGE=ghcr.io/K-sewii/tourvoice-web
IMAGE_TAG=latest

DB_PASSWORD=change-me-password
DB_ROOT_PASSWORD=change-me-root

JWT_KEY=change-me-to-a-random-secret-at-least-32-characters
JWT_ISSUER=TourVoice
JWT_AUDIENCE=TourVoiceClient

MYMEMORY_EMAIL=team@example.com

# Domain cong khai cua web (dung cho CORS). VD https://tourvoice.example.com
WEB_ORIGIN=https://tourvoice.example.com

# true o lan deploy dau de migrate + seed admin, sau do doi thanh false.
INITIALIZE_ON_STARTUP=true
