{
  "name": "TourVoice",
  "image": "mcr.microsoft.com/devcontainers/base:jammy",
  "features": {
  "ghcr.io/devcontainers/features/docker-in-docker:2": {
    "version": "latest",
    "dockerDashComposeVersion": "v2",
    "moby": false
    }
  },
  "forwardPorts": [5173, 5049],
  "portsAttributes": {
    "5173": {
      "label": "TourVoice Web",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    },
    "5049": {
      "label": "TourVoice API (Swagger)",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh && bash .devcontainer/start-docker.sh"
}
